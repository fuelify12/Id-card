# Public Supabase project URL; safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=

# Public/publishable Supabase client key; never place a service-role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical application origin used for redirects; set separately per environment.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional server-only Gemini API key for template analysis. Never use a NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=

# Template-analysis model identifier (not a credential).
GEMINI_TEMPLATE_MODEL=gemini-3.8-flash
